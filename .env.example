APP_API_KEY=
APP_API_SECRET=
APP_PORT=3000

MAX_FILE_SIZE=

# Receipt extraction and categorization LLM.
# Required: gemini, openai, anthropic, or openai-compatible
AI_PROVIDER=

# Gemini extraction profile
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

# OpenAI extraction profile
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Anthropic extraction profile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

# OpenAI-compatible extraction profile
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=

# Optional document parsing step. Leave blank to send the document directly to
# the extraction LLM. Supported: local, gemini, openai, anthropic,
# openai-compatible. A non-local parser must use an image-capable model and its
# corresponding parser profile below.
RECEIPT_PARSER_PROVIDER=

RECEIPT_PARSER_GEMINI_API_KEY=
RECEIPT_PARSER_GEMINI_MODEL=
RECEIPT_PARSER_GEMINI_BASE_URL=

RECEIPT_PARSER_OPENAI_API_KEY=
RECEIPT_PARSER_OPENAI_MODEL=
RECEIPT_PARSER_OPENAI_BASE_URL=

RECEIPT_PARSER_ANTHROPIC_API_KEY=
RECEIPT_PARSER_ANTHROPIC_MODEL=
RECEIPT_PARSER_ANTHROPIC_BASE_URL=

RECEIPT_PARSER_OPENAI_COMPATIBLE_API_KEY=
RECEIPT_PARSER_OPENAI_COMPATIBLE_MODEL=
RECEIPT_PARSER_OPENAI_COMPATIBLE_BASE_URL=

RECEIPT_PARSER_MAX_PDF_PAGES=5

YNAB_API_KEY=
YNAB_BUDGET_ID=
YNAB_CATEGORY_GROUPS=
YNAB_INCLUDE_PAYEES_IN_PROMPT=true

# Choose file storage provider: s3, local
FILE_STORAGE=
DATE_SUBDIRECTORIES=

# Local Configuration
LOCAL_DIRECTORY=

# S3 Configuration
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PATH_PREFIX=
S3_ENDPOINT=
